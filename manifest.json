{
  "schemaVersion": 1,
  "id": "io.github.compourri.omatoki",
  "name": "Omatoki",
  "version": "0.1.0",
  "author": "Compourri",
  "license": "MIT",
  "description": "Clock + calendar + weather at a glance — hero time, month/year/life progress, month grid, and forecast in one Omarchy panel.",
  "keywords": ["clock", "calendar", "weather", "time", "omatoki", "dashboard"],
  "homepage": "https://github.com/compourri/omatoki",
  "repository": "https://github.com/compourri/omatoki.git",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omatoki",
    "description": "Clock, calendar & weather — hero time + month grid + forecast",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "format": "dddd HH:mm",
      "formatAlt": "d MMMM 'W'ww yyyy",
      "verticalFormat": "HH\n—\nmm",
      "verticalFormatAlt": "dd\nMMM\n'W'ww\n''yy",
      "weekStartDay": null,
      "birthYear": 0,
      "lifeExpectancy": 90
    },
    "schema": [
      { "key": "format", "type": "string", "label": "Bar format (horizontal)" },
      { "key": "formatAlt", "type": "string", "label": "Bar alt format (horizontal, right-click cycles)" },
      { "key": "weekStartDay", "type": "string", "label": "Week starts on (sunday/monday, empty = locale)" },
      { "key": "birthYear", "type": "integer", "label": "Birth year (for life progress, 0 = hidden)" },
      { "key": "lifeExpectancy", "type": "integer", "label": "Life expectancy (default 90)" }
    ]
  },
  "omarchy": {
    "clonedFrom": "omarchy.clock"
  }
}
