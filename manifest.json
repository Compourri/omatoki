{
  "schemaVersion": 1,
  "id": "io.github.compourri.omatoki",
  "name": "Omatoki",
  "version": "0.1.0",
  "author": "Compourri",
  "license": "MIT",
  "description": "Clock, calendar, weather, media player, and system monitors in one gorgeous dashboard panel.",
  "keywords": [
    "clock",
    "calendar",
    "weather",
    "mpris",
    "media",
    "system",
    "monitor",
    "dashboard",
    "time",
    "omatoki"
  ],
  "homepage": "https://github.com/Compourri/omatoki",
  "repository": "https://github.com/Compourri/omatoki.git",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omatoki",
    "description": "Clock, calendar & weather \u2014 hero time + month grid + forecast",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "format": "dddd HH:mm",
      "formatAlt": "d MMMM 'W'ww yyyy",
      "verticalFormat": "HH\n\u2014\nmm",
      "verticalFormatAlt": "dd\nMMM\n'W'ww\n''yy",
      "weekStartDay": null,
      "birthYear": 0,
      "lifeExpectancy": 90
    },
    "schema": [
      {
        "key": "format",
        "type": "string",
        "label": "Bar format (horizontal)"
      },
      {
        "key": "formatAlt",
        "type": "string",
        "label": "Bar alt format (horizontal, right-click cycles)"
      },
      {
        "key": "weekStartDay",
        "type": "string",
        "label": "Week starts on (sunday/monday, empty = locale)"
      },
      {
        "key": "birthYear",
        "type": "integer",
        "label": "Birth year (for life progress, 0 = hidden)"
      },
      {
        "key": "lifeExpectancy",
        "type": "integer",
        "label": "Life expectancy (default 90)"
      },
      {
        "key": "unit",
        "type": "string",
        "label": "Units (metric/imperial, empty = auto)"
      },
      {
        "key": "refreshMinutes",
        "type": "integer",
        "label": "Weather refresh interval in minutes (default 15)"
      }
    ]
  },
  "omarchy": {
    "clonedFrom": "omarchy.clock"
  }
}